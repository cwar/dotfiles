#!/usr/bin/env python3
"""Launch Waybar on the right KDE output for docked and undocked use.

The checked-in KDE Waybar config keeps the full module/layout definition. This
launcher generates a runtime copy with only the `output` selector changed:

- external enabled/connected output present: draw on all non-laptop outputs
- only the laptop panel is active: draw on eDP-1

It then supervises Waybar and restarts it when KScreen's output topology changes
between those two states.
"""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import time
from typing import Any

BASE_CONFIG = Path(
    os.environ.get("WAYBAR_KDE_CONFIG", Path.home() / ".config/waybar/config-kde.jsonc")
)
STYLE_CONFIG = Path(
    os.environ.get("WAYBAR_KDE_STYLE", Path.home() / ".config/waybar/style-kde.css")
)
WAYBAR_BIN = os.environ.get("WAYBAR_BIN", "/usr/bin/waybar")
POLL_SECONDS = float(os.environ.get("WAYBAR_KDE_POLL_SECONDS", "2"))
LAPTOP_OUTPUT = os.environ.get("WAYBAR_KDE_LAPTOP_OUTPUT", "eDP-1")
EXTERNAL_OUTPUT_SELECTOR = os.environ.get("WAYBAR_KDE_EXTERNAL_OUTPUT", f"!{LAPTOP_OUTPUT}")

_OUTPUT_LINE_RE = re.compile(
    r'(?m)^(?P<indent>\s*)"output"\s*:\s*(?P<value>"(?:\\.|[^"])*"|\[[^\n]*\]|[^,\n]+),'
)


def is_laptop_output(name: str) -> bool:
    """Return true for internal laptop panels such as eDP-1."""

    return name.lower().startswith("edp-") or name.lower() == "edp"


def choose_output_selector(config: dict[str, Any]) -> str:
    """Choose the Waybar output selector from `kscreen-doctor -j` data."""

    outputs = config.get("outputs", [])
    if not isinstance(outputs, list):
        return LAPTOP_OUTPUT

    for output in outputs:
        if not isinstance(output, dict):
            continue
        name = str(output.get("name", ""))
        if not name:
            continue
        if output.get("enabled") is True and output.get("connected") is True:
            if not is_laptop_output(name):
                return EXTERNAL_OUTPUT_SELECTOR

    return LAPTOP_OUTPUT


def read_kscreen_json() -> dict[str, Any]:
    """Read the live KScreen output configuration."""

    proc = subprocess.run(
        ["kscreen-doctor", "-j"],
        check=True,
        capture_output=True,
        text=True,
    )
    data = json.loads(proc.stdout)
    if not isinstance(data, dict):
        raise ValueError("kscreen-doctor did not return a JSON object")
    return data


def decide_live_output_selector() -> str:
    """Choose the output selector for the current live display topology."""

    return choose_output_selector(read_kscreen_json())


def render_runtime_config(output_selector: str) -> str:
    """Return config-kde.jsonc with its `output` selector replaced."""

    source = BASE_CONFIG.read_text(encoding="utf-8")
    replacement = rf'\g<indent>"output": "{output_selector}",'
    rendered, count = _OUTPUT_LINE_RE.subn(replacement, source, count=1)
    if count != 1:
        raise ValueError(f"expected exactly one top-level output line in {BASE_CONFIG}")

    return (
        "// Generated by scripts/waybar-kde-launch; edit config-kde.jsonc instead.\n"
        + rendered
    )


def runtime_config_path() -> Path:
    """Return the generated config path under XDG_RUNTIME_DIR when available."""

    base = Path(os.environ.get("XDG_RUNTIME_DIR", Path.home() / ".cache"))
    path = base / "waybar" / "config-kde-active.jsonc"
    path.parent.mkdir(parents=True, exist_ok=True)
    return path


def write_runtime_config(output_selector: str) -> Path:
    """Write the generated runtime config atomically and return its path."""

    target = runtime_config_path()
    tmp = target.with_suffix(target.suffix + ".tmp")
    tmp.write_text(render_runtime_config(output_selector), encoding="utf-8")
    tmp.replace(target)
    return target


def stop_child(child: subprocess.Popen[bytes], timeout: float = 5.0) -> None:
    """Terminate a child process, escalating to kill if it does not exit."""

    if child.poll() is not None:
        return
    child.terminate()
    try:
        child.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        child.kill()
        child.wait(timeout=timeout)


def is_waybar_process(argv0: str, comm: str) -> bool:
    """Return true when proc metadata belongs to a real Waybar process."""

    return comm == "waybar" or Path(argv0).name == "waybar"


def iter_waybar_pids() -> list[int]:
    """Return PIDs for running Waybar processes without shell-grep false positives."""

    pids: list[int] = []
    proc_root = Path("/proc")
    for entry in proc_root.iterdir():
        if not entry.name.isdigit():
            continue
        try:
            cmdline = (entry / "cmdline").read_bytes().split(b"\0")
            argv0 = cmdline[0].decode(errors="replace") if cmdline and cmdline[0] else ""
            comm = (entry / "comm").read_text(encoding="utf-8").strip()
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            continue
        if is_waybar_process(argv0, comm):
            pids.append(int(entry.name))
    return pids


def process_exists(pid: int) -> bool:
    """Return true if a PID still exists."""

    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def cleanup_unmanaged_waybars(managed_pid: int | None) -> None:
    """Terminate Waybar processes not owned as this supervisor's current child."""

    if os.environ.get("WAYBAR_KDE_ALLOW_UNMANAGED") == "1":
        return

    victims = [pid for pid in iter_waybar_pids() if pid != managed_pid]
    for pid in victims:
        print(f"waybar-kde-launch: stopping unmanaged Waybar pid={pid}", file=sys.stderr)
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            continue
        except PermissionError as exc:
            print(f"waybar-kde-launch: cannot stop unmanaged Waybar pid={pid}: {exc}", file=sys.stderr)

    deadline = time.monotonic() + 2.0
    while time.monotonic() < deadline:
        if not any(process_exists(pid) for pid in victims):
            return
        time.sleep(0.1)

    for pid in victims:
        if not process_exists(pid):
            continue
        print(f"waybar-kde-launch: killing unmanaged Waybar pid={pid}", file=sys.stderr)
        try:
            os.kill(pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            continue


class WaybarSupervisor:
    """Supervise Waybar and restart it when the desired output changes."""

    def __init__(self) -> None:
        self.child: subprocess.Popen[bytes] | None = None
        self.current_output = ""
        self.stopping = False

    def handle_signal(self, signum: int, _frame: object) -> None:
        print(f"waybar-kde-launch: received signal {signum}, stopping", file=sys.stderr)
        self.stopping = True
        if self.child is not None:
            stop_child(self.child)

    def start_waybar(self, output_selector: str) -> None:
        cleanup_unmanaged_waybars(None)
        config = write_runtime_config(output_selector)
        print(
            f"waybar-kde-launch: starting Waybar with output={output_selector} config={config}",
            file=sys.stderr,
        )
        self.current_output = output_selector
        self.child = subprocess.Popen(
            [WAYBAR_BIN, "-c", str(config), "-s", str(STYLE_CONFIG)]
        )

    def restart_waybar(self, output_selector: str) -> None:
        if self.child is not None:
            stop_child(self.child)
        self.start_waybar(output_selector)

    def run(self) -> int:
        signal.signal(signal.SIGINT, self.handle_signal)
        signal.signal(signal.SIGTERM, self.handle_signal)

        while not self.stopping:
            try:
                desired_output = decide_live_output_selector()
            except Exception as exc:  # noqa: BLE001 - keep the status bar alive if KScreen hiccups.
                print(f"waybar-kde-launch: failed to read KScreen state: {exc}", file=sys.stderr)
                desired_output = self.current_output or LAPTOP_OUTPUT

            child_exited = self.child is None or self.child.poll() is not None
            output_changed = desired_output != self.current_output

            if self.child is not None and not child_exited:
                cleanup_unmanaged_waybars(self.child.pid)

            if child_exited:
                if self.child is not None:
                    print(
                        f"waybar-kde-launch: Waybar exited with code {self.child.returncode}; restarting",
                        file=sys.stderr,
                    )
                self.start_waybar(desired_output)
            elif output_changed:
                print(
                    "waybar-kde-launch: output selector changed "
                    f"{self.current_output} -> {desired_output}; restarting Waybar",
                    file=sys.stderr,
                )
                self.restart_waybar(desired_output)

            time.sleep(POLL_SECONDS)

        if self.child is not None:
            stop_child(self.child)
        return 0


def run_self_test() -> int:
    """Run dependency-free unit tests for the output selector decision."""

    cases = [
        (
            "laptop only",
            {"outputs": [{"name": "eDP-1", "enabled": True, "connected": True}]},
            LAPTOP_OUTPUT,
        ),
        (
            "external only",
            {"outputs": [{"name": "DP-1", "enabled": True, "connected": True}]},
            EXTERNAL_OUTPUT_SELECTOR,
        ),
        (
            "external plus laptop",
            {
                "outputs": [
                    {"name": "eDP-1", "enabled": True, "connected": True},
                    {"name": "HDMI-A-1", "enabled": True, "connected": True},
                ]
            },
            EXTERNAL_OUTPUT_SELECTOR,
        ),
        (
            "disabled external ignored",
            {
                "outputs": [
                    {"name": "eDP-1", "enabled": True, "connected": True},
                    {"name": "DP-1", "enabled": False, "connected": True},
                ]
            },
            LAPTOP_OUTPUT,
        ),
        ("malformed outputs", {"outputs": "oops"}, LAPTOP_OUTPUT),
    ]

    for name, data, expected in cases:
        actual = choose_output_selector(data)
        if actual != expected:
            print(
                f"FAIL {name}: expected {expected!r}, got {actual!r}",
                file=sys.stderr,
            )
            return 1

    process_cases = [
        ("/usr/bin/waybar", "waybar", True),
        ("waybar", "waybar", True),
        ("/bin/bash", "bash", False),
        ("/usr/bin/python3", "python3", False),
        ("/tmp/not-waybar", "not-waybar", False),
    ]
    for argv0, comm, expected in process_cases:
        actual = is_waybar_process(argv0, comm)
        if actual != expected:
            print(
                f"FAIL process predicate {argv0!r}/{comm!r}: expected {expected}, got {actual}",
                file=sys.stderr,
            )
            return 1

    rendered = render_runtime_config("eDP-1")
    if '"output": "eDP-1",' not in rendered:
        print("FAIL render_runtime_config did not replace output", file=sys.stderr)
        return 1

    print("waybar-kde-launch self-test passed")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--decide-output", action="store_true", help="print the current output selector and exit")
    parser.add_argument("--write-config", action="store_true", help="write the generated config and print its path")
    parser.add_argument("--self-test", action="store_true", help="run unit tests and exit")
    args = parser.parse_args()

    if args.self_test:
        return run_self_test()

    if args.decide_output or args.write_config:
        output_selector = decide_live_output_selector()
        if args.write_config:
            print(write_runtime_config(output_selector))
        else:
            print(output_selector)
        return 0

    return WaybarSupervisor().run()


if __name__ == "__main__":
    raise SystemExit(main())
