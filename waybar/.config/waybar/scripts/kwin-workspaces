#!/usr/bin/env python3
"""Waybar KWin virtual-desktop workspaces: per-desktop, clickable, occupied-only.

Architecture (one module per desktop so each is individually clickable):

  kwin-occupancy.js  --(D-Bus push)-->  daemon  --writes-->  state file
                                           |                  ($XDG_RUNTIME_DIR)
                                           '--SIGRTMIN+1-->  waybar (refresh)

  custom/ws<N> modules each run `render <N>` (read state file, print that one
  desktop's JSON; empty => hidden) and `goto <N>` on click (switch to it).

Modes:
  daemon      host the org.waybar.Kwin D-Bus service, load the KWin script,
              persist pushed state to the state file, and signal waybar.
  render <N>  print the JSON for desktop index N (empty text if hidden).
  goto <N>    switch to desktop index N.
  next|prev   switch to next/previous desktop (wraps) -- used for scroll.
  dump        print the current state file (debugging).
"""
import json
import os
import re
import signal
import subprocess
import sys

KWIN_DEST = "org.kde.KWin"
SCRIPTING_OBJ = "/Scripting"
SCRIPTING_IFACE = "org.kde.kwin.Scripting"
PLUGIN = "waybar-occupancy"
JS_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "kwin-occupancy.js")

VDM_OBJ = "/VirtualDesktopManager"
VDM_IFACE = "org.kde.KWin.VirtualDesktopManager"

STATE_FILE = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "waybar-kwin-state.json"
)
WAYBAR_SIGNAL = "1"  # matches "signal": 1 in the per-desktop modules

_DEFAULT_NAME_RE = re.compile(r"^Desktop (\d+)$")


# ---------------------------------------------------------------- state file
def read_state():
    try:
        with open(STATE_FILE) as f:
            return json.load(f)
    except Exception:
        return {}


def write_state(data):
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.replace(tmp, STATE_FILE)


# ---------------------------------------------------------------- rendering
def label_for(number, name):
    if name == "Scratch":
        return "\U000f02a0"  # 󰊠
    if _DEFAULT_NAME_RE.match(name):
        return str(number)
    return name


def cmd_render(n):
    state = read_state()
    desktops = state.get("desktops", [])
    if n < 0 or n >= len(desktops):
        print('{"text": ""}', flush=True)
        return
    current = state.get("current", "")
    occupied = set(state.get("occupied", []))
    d = desktops[n]
    did = d.get("id")
    name = d.get("name", "")
    if did != current and did not in occupied:
        print('{"text": ""}', flush=True)  # occupied-only (current always shown)
        return
    label = label_for(n + 1, name)
    cls = ["ws", "active"] if did == current else ["ws"]
    print(json.dumps({"text": label, "class": cls, "tooltip": name}), flush=True)


# ---------------------------------------------------------- desktop switching
_DESKTOP_RE = re.compile(r"\((?:uint32 )?(\d+), '([0-9a-fA-F-]+)', '([^']*)'\)")
_CURRENT_RE = re.compile(r"'current': <'([^']+)'>")


def _gdbus_vdm(*args):
    return subprocess.run(
        ["gdbus", "call", "--session", "--dest", KWIN_DEST,
         "--object-path", VDM_OBJ, *args],
        capture_output=True, text=True,
    ).stdout


def vdm_state():
    out = _gdbus_vdm("--method", "org.freedesktop.DBus.Properties.GetAll", VDM_IFACE)
    m = _CURRENT_RE.search(out)
    current = m.group(1) if m else ""
    desks = [(int(p), u, n) for (p, u, n) in _DESKTOP_RE.findall(out)]
    desks.sort(key=lambda d: d[0])
    return current, desks


def _set_current(uuid):
    _gdbus_vdm("--method", "org.freedesktop.DBus.Properties.Set",
               VDM_IFACE, "current", f"<'{uuid}'>")


def cmd_goto(n):
    _, desks = vdm_state()
    if 0 <= n < len(desks):
        _set_current(desks[n][1])


def cmd_switch(direction):
    current, desks = vdm_state()
    if not desks:
        return
    idx = next((i for i, (_, u, _) in enumerate(desks) if u == current), 0)
    idx = (idx + 1) % len(desks) if direction == "next" else (idx - 1) % len(desks)
    _set_current(desks[idx][1])


# ------------------------------------------------------- KWin script lifecycle
def _scripting(method, *args):
    return subprocess.run(
        ["gdbus", "call", "--session", "--dest", KWIN_DEST,
         "--object-path", SCRIPTING_OBJ, "--method", f"{SCRIPTING_IFACE}.{method}", *args],
        capture_output=True, text=True,
    )


def load_script():
    _scripting("unloadScript", PLUGIN)
    _scripting("loadScript", JS_PATH, PLUGIN)
    _scripting("start")


def unload_script():
    _scripting("unloadScript", PLUGIN)


def signal_waybar():
    subprocess.run(["pkill", f"-RTMIN+{WAYBAR_SIGNAL}", "waybar"],
                   capture_output=True)


# -------------------------------------------------------------------- daemon
def cmd_daemon():
    import warnings
    warnings.filterwarnings("ignore")  # silence PyGI/Gio deprecation noise
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib

    # This module itself shows nothing; it just supervises state.
    print('{"text": ""}', flush=True)

    node_xml = (
        "<node><interface name='org.waybar.Kwin'>"
        "<method name='Update'><arg type='s' name='payload' direction='in'/></method>"
        "</interface></node>"
    )
    node = Gio.DBusNodeInfo.new_for_xml(node_xml)
    loop = GLib.MainLoop()

    def on_method(conn, sender, path, iface, method, params, invocation):
        if method == "Update":
            payload = params.unpack()[0]
            try:
                write_state(json.loads(payload))
            except Exception:
                pass
            signal_waybar()
            invocation.return_value(None)

    def on_bus_acquired(conn, name):
        conn.register_object("/org/waybar/Kwin", node.interfaces[0], on_method)
        load_script()

    def shutdown():
        unload_script()
        loop.quit()
        return False

    Gio.bus_own_name(
        Gio.BusType.SESSION, "org.waybar.Kwin",
        Gio.BusNameOwnerFlags.REPLACE | Gio.BusNameOwnerFlags.ALLOW_REPLACEMENT,
        on_bus_acquired, None, None,
    )
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, shutdown)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, shutdown)
    loop.run()


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    rest = sys.argv[2] if len(sys.argv) > 2 else ""
    if arg == "daemon":
        cmd_daemon()
    elif arg == "render":
        cmd_render(int(rest) if rest.isdigit() else -1)
    elif arg == "goto":
        cmd_goto(int(rest) if rest.lstrip("-").isdigit() else -1)
    elif arg in ("next", "prev"):
        cmd_switch(arg)
    elif arg == "dump":
        print(json.dumps(read_state(), indent=2))


if __name__ == "__main__":
    main()
