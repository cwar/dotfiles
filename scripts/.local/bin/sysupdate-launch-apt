#!/usr/bin/env bash
set -uo pipefail

# sysupdate-launch — Waybar on-click handler for the custom/sysupdate module.
#
# Waybar runs this with no controlling terminal, so we re-exec ourselves inside
# a Ghostty window (guarded by SYSUPDATE_IN_TERM) and run the interactive update
# there. Updates every package manager present on this box, then fetches and
# safely fast-forwards master for explicitly allowlisted git checkouts.
# Sudo is primed ONCE so apt + snap don't each prompt; Waybar is signalled
# (SIGRTMIN+8) afterward to re-check.
#
# Ported from the Omarchy/Arch `update-all`; the orchestration (single sudo,
# per-manager isolation, bar refresh) is the same, the commands are Ubuntu's.

self=$(readlink -f "$0")
here=$(dirname "$self")
CHECK="$here/sysupdate-check"

# Per-machine allowlist (one path per line, ~ allowed); kept out of this public repo.
GIT_UPDATE_REPOS_FILE=${SYSUPDATE_GIT_REPOS:-${XDG_CONFIG_HOME:-$HOME/.config}/sysupdate/git-repos}
GIT_UPDATE_REPOS=()
if [[ -r $GIT_UPDATE_REPOS_FILE ]]; then
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line || $line == \#* ]] && continue
    GIT_UPDATE_REPOS+=("${line/#\~/$HOME}")
  done <"$GIT_UPDATE_REPOS_FILE"
fi

TERMINAL=${TERMINAL:-ghostty}

# prepend_mise_shims: make mise-managed node/npm (and the globals they own, e.g.
# pi) resolvable. Waybar/systemd don't source ~/.bashrc where `mise activate`
# runs, so without this `have npm` is false and the `npm update -g` step is
# skipped. Exported before the re-exec so the terminal child inherits it too.
# Idempotent; honours $MISE_SHIMS to allow testing.
prepend_mise_shims() {
  local shims=${MISE_SHIMS:-$HOME/.local/share/mise/shims}
  [[ -d $shims ]] || return 0
  case ":$PATH:" in
    *":$shims:"*) ;;
    *)
      PATH="$shims:$PATH"
      export PATH
      ;;
  esac
}
prepend_mise_shims

# update_git_repo REPO BRANCH: fetch the branch from origin and safely advance
# its local branch. Never switches the current branch, merges divergent work,
# resets commits, or modifies a dirty worktree.
update_git_repo() {
  local repo=$1 branch=${2:-master}
  local local_ref="refs/heads/$branch"
  local remote_ref="refs/remotes/origin/$branch"
  local current before after

  if [[ ! -d $repo ]] || ! git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
    printf '\033[33m⚠ %s is not a Git checkout; skipping.\033[0m\n' "$repo"
    return 0
  fi

  if ! git -C "$repo" remote get-url origin >/dev/null 2>&1; then
    printf '\033[33m⚠ %s has no origin remote; skipping.\033[0m\n' "$repo"
    return 0
  fi

  printf 'Fetching origin/%s…\n' "$branch"
  git -C "$repo" fetch --quiet origin "$branch" || return 1
  git -C "$repo" show-ref --verify --quiet "$remote_ref" || {
    printf '\033[33m⚠ origin/%s was not found; skipping.\033[0m\n' "$branch"
    return 0
  }

  current=$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  if [[ $current == "$branch" ]]; then
    if [[ -n $(git -C "$repo" status --porcelain) ]]; then
      printf '\033[33m⚠ %s is checked out with local changes; fetched only.\033[0m\n' "$branch"
      return 0
    fi

    before=$(git -C "$repo" rev-parse "$local_ref")
    if git -C "$repo" merge-base --is-ancestor "$local_ref" "$remote_ref"; then
      git -C "$repo" merge --quiet --ff-only "$remote_ref" || return 1
      after=$(git -C "$repo" rev-parse "$local_ref")
      if [[ $before == "$after" ]]; then
        printf '%s is already up to date.\n' "$branch"
      else
        printf 'Fast-forwarded %s: %.12s → %.12s\n' "$branch" "$before" "$after"
      fi
      return 0
    fi

    if git -C "$repo" merge-base --is-ancestor "$remote_ref" "$local_ref"; then
      printf '%s already contains origin/%s.\n' "$branch" "$branch"
      return 0
    fi

    printf '\033[33m⚠ %s and origin/%s have diverged; fetched only.\033[0m\n' "$branch" "$branch"
    return 0
  fi

  if ! git -C "$repo" show-ref --verify --quiet "$local_ref"; then
    git -C "$repo" branch --track "$branch" "origin/$branch" >/dev/null || return 1
    printf 'Created local %s at origin/%s; kept %s checked out.\n' \
      "$branch" "$branch" "${current:-detached HEAD}"
    return 0
  fi

  if git -C "$repo" merge-base --is-ancestor "$local_ref" "$remote_ref"; then
    before=$(git -C "$repo" rev-parse "$local_ref")
    after=$(git -C "$repo" rev-parse "$remote_ref")
    if [[ $before == "$after" ]]; then
      printf '%s is already up to date; kept %s checked out.\n' \
        "$branch" "${current:-detached HEAD}"
      return 0
    fi

    if git -C "$repo" worktree list --porcelain | grep -Fxq "branch $local_ref"; then
      printf '\033[33m⚠ %s is checked out in another worktree; fetched only.\033[0m\n' "$branch"
      return 0
    fi

    git -C "$repo" branch -f "$branch" "$remote_ref" >/dev/null || return 1
    printf 'Fast-forwarded %s: %.12s → %.12s; kept %s checked out.\n' \
      "$branch" "$before" "$after" "${current:-detached HEAD}"
    return 0
  fi

  if git -C "$repo" merge-base --is-ancestor "$remote_ref" "$local_ref"; then
    printf '%s already contains origin/%s; kept %s checked out.\n' \
      "$branch" "$branch" "${current:-detached HEAD}"
    return 0
  fi

  printf '\033[33m⚠ %s and origin/%s have diverged; fetched only.\033[0m\n' "$branch" "$branch"
  return 0
}

# ---- self test --------------------------------------------------------------

self_test() {
  local fails=0
  check() {
    local desc=$1 got=$2 want=$3
    if [[ $got == "$want" ]]; then
      printf 'ok   - %s\n' "$desc"
    else
      printf 'FAIL - %s (got %q want %q)\n' "$desc" "$got" "$want"
      fails=$((fails + 1))
    fi
  }

  local tmp remote seed work upstream
  tmp=$(mktemp -d) || return 1
  remote=$tmp/remote.git
  seed=$tmp/seed
  work=$tmp/work
  upstream=$tmp/upstream

  git init -q --bare "$remote"
  git init -q "$seed"
  git -C "$seed" checkout -q -b master
  git -C "$seed" config user.name "sysupdate test"
  git -C "$seed" config user.email "sysupdate@example.invalid"
  git -C "$seed" config core.hooksPath /dev/null
  printf 'initial\n' >"$seed/tracked"
  git -C "$seed" add tracked
  git -C "$seed" -c commit.gpgsign=false commit -qm "initial"
  git -C "$seed" remote add origin "$remote"
  git -C "$seed" push -q -u origin master
  git --git-dir="$remote" symbolic-ref HEAD refs/heads/master

  git clone -q "$remote" "$work"
  git clone -q "$remote" "$upstream"
  git -C "$work" config user.name "sysupdate test"
  git -C "$work" config user.email "sysupdate@example.invalid"
  git -C "$work" config core.hooksPath /dev/null
  git -C "$upstream" config user.name "sysupdate test"
  git -C "$upstream" config user.email "sysupdate@example.invalid"
  git -C "$upstream" config core.hooksPath /dev/null

  printf 'master update\n' >>"$upstream/tracked"
  git -C "$upstream" -c commit.gpgsign=false commit -qam "master update"
  git -C "$upstream" push -q origin master

  local status got want before
  update_git_repo "$work" master >/dev/null 2>&1
  status=$?
  got=$(git -C "$work" rev-parse master)
  want=$(git -C "$upstream" rev-parse master)
  check "clean checked-out master update succeeds" "$status" "0"
  check "clean checked-out master fast-forwards" "$got" "$want"

  git -C "$work" checkout -q -b feature
  before=$(git -C "$work" rev-parse HEAD)
  printf 'another update\n' >>"$upstream/tracked"
  git -C "$upstream" -c commit.gpgsign=false commit -qam "another update"
  git -C "$upstream" push -q origin master

  update_git_repo "$work" master >/dev/null 2>&1
  status=$?
  got=$(git -C "$work" rev-parse master)
  want=$(git -C "$upstream" rev-parse master)
  check "master update succeeds from a feature branch" "$status" "0"
  check "master advances from a feature branch" "$got" "$want"
  check "feature worktree is not changed" "$(git -C "$work" rev-parse HEAD)" "$before"
  check "feature branch remains checked out" "$(git -C "$work" symbolic-ref --short HEAD)" "feature"

  git -C "$work" checkout -q master
  printf 'local change\n' >>"$work/tracked"
  before=$(git -C "$work" rev-parse master)
  printf 'dirty skip update\n' >>"$upstream/tracked"
  git -C "$upstream" -c commit.gpgsign=false commit -qam "dirty skip update"
  git -C "$upstream" push -q origin master

  update_git_repo "$work" master >/dev/null 2>&1
  status=$?
  check "dirty checked-out master is a safe skip" "$status" "0"
  check "dirty checked-out master is not moved" "$(git -C "$work" rev-parse master)" "$before"

  git -C "$work" reset --hard -q
  printf 'local master commit\n' >>"$work/tracked"
  git -C "$work" -c commit.gpgsign=false commit -qam "local master commit"
  before=$(git -C "$work" rev-parse master)
  update_git_repo "$work" master >/dev/null 2>&1
  status=$?
  check "diverged master is a safe skip" "$status" "0"
  check "diverged master is not moved" "$(git -C "$work" rev-parse master)" "$before"

  rm -rf "$tmp"
  printf '\n%d failure(s)\n' "$fails"
  return "$fails"
}

if [[ ${1:-} == --self-test ]]; then
  self_test
  exit $?
fi

# ---- terminal re-exec -------------------------------------------------------

if [[ -z ${SYSUPDATE_IN_TERM:-} ]]; then
  if command -v "$TERMINAL" >/dev/null 2>&1; then
    exec "$TERMINAL" --title="System Update" -e \
      env SYSUPDATE_IN_TERM=1 "$self"
  elif command -v konsole >/dev/null 2>&1; then
    exec konsole -e env SYSUPDATE_IN_TERM=1 "$self"
  else
    # No terminal — run headless (best effort, no prompts).
    SYSUPDATE_IN_TERM=1 SYSUPDATE_HEADLESS=1 exec "$self"
  fi
fi

# ---- helpers ----------------------------------------------------------------

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
dim() { printf '\033[2m%s\033[0m\n' "$*"; }
rule() { printf '\033[2m%s\033[0m\n' "────────────────────────────────────────"; }

FAILED=()

# run_step NAME CMD...: run an upgrade step, isolated so one failure doesn't
# abort the rest. Records failures for the final summary.
run_step() {
  local name=$1
  shift
  rule
  bold "▶ $name"
  if "$@"; then
    return 0
  fi
  printf '\033[31m✗ %s failed (continuing)\033[0m\n' "$name"
  FAILED+=("$name")
  return 0
}

have() { command -v "$1" >/dev/null 2>&1; }

flatpak_failed_only_because_remote_is_older() {
  local output=$1
  printf '%s\n' "$output" | grep -q 'Update is older than current version' || return 1

  ! printf '%s\n' "$output" |
    grep -Ei '(^|[[:space:]])error:' |
    grep -Fvi 'Update is older than current version' |
    grep -Fvi 'There were one or more errors' >/dev/null
}

flatpak_update() {
  local output status
  output=$(flatpak update -y 2>&1)
  status=$?
  printf '%s\n' "$output"

  if ((status == 0)); then
    return 0
  fi

  if flatpak_failed_only_because_remote_is_older "$output"; then
    printf '\033[33m⚠ flatpak remote offered an older commit; ignoring as not actionable.\033[0m\n'
    return 0
  fi

  return "$status"
}

confirm() {
  local prompt=$1
  if [[ -n ${SYSUPDATE_HEADLESS:-} ]]; then
    return 0
  fi
  if have gum; then
    gum confirm "$prompt"
    return $?
  fi
  local reply
  printf '%s [y/N] ' "$prompt"
  read -r reply || return 1
  [[ $reply == [yY]* ]]
}

# keep sudo credentials warm for the duration of the run
SUDO_KEEPALIVE_PID=""
prime_sudo() {
  have sudo || return 0
  bold "Priming sudo (one prompt for the whole run)…"
  sudo -v || return 1
  (while true; do
    sudo -n true 2>/dev/null || exit
    sleep 50
  done) &
  SUDO_KEEPALIVE_PID=$!
}
cleanup() {
  [[ -n $SUDO_KEEPALIVE_PID ]] && kill "$SUDO_KEEPALIVE_PID" 2>/dev/null
}
trap cleanup EXIT

# ---- main flow --------------------------------------------------------------

clear 2>/dev/null || true
bold "System update"
rule
dim "Pending package updates:"
"$CHECK" --summary || true
dim "Git targets:"
for repo in ${GIT_UPDATE_REPOS[@]+"${GIT_UPDATE_REPOS[@]}"}; do
  repo_label=${repo#"$HOME/"}
  printf '  %-20s %s\n' "$repo_label" "master"
done
echo

if ! confirm "Run system and monorepo updates?"; then
  dim "Cancelled."
  exit 0
fi

# Whether we need root at all (apt/snap). Prime once if so.
if have apt || have snap; then
  prime_sudo || {
    printf '\033[31mCould not obtain sudo; apt/snap will be skipped.\033[0m\n'
  }
fi

if have apt && [[ -n $SUDO_KEEPALIVE_PID ]]; then
  run_step "apt" bash -c 'sudo apt update && sudo apt full-upgrade -y && sudo apt autoremove -y'
fi

if have flatpak; then
  run_step "flatpak" flatpak_update
fi

if have snap && [[ -n $SUDO_KEEPALIVE_PID ]]; then
  run_step "snap" sudo snap refresh
fi

if have brew; then
  run_step "Homebrew" bash -c 'brew update && brew upgrade'
fi

if have npm; then
  run_step "npm (global)" npm update -g
fi

if have mise; then
  run_step "mise" mise upgrade
fi

if have git; then
  for repo in ${GIT_UPDATE_REPOS[@]+"${GIT_UPDATE_REPOS[@]}"}; do
    repo_label=${repo#"$HOME/"}
    run_step "Git: $repo_label (master)" update_git_repo "$repo" master
  done
fi

rule
if ((${#FAILED[@]} == 0)); then
  bold "✓ All updates complete."
  have notify-send && notify-send "System update" "All package managers updated." 2>/dev/null || true
else
  printf '\033[33m⚠ Completed with failures: %s\033[0m\n' "${FAILED[*]}"
  have notify-send && notify-send "System update" "Completed with failures: ${FAILED[*]}" 2>/dev/null || true
fi

# Refresh the Waybar indicator immediately (custom/sysupdate uses signal 8).
pkill -RTMIN+8 waybar 2>/dev/null || true

if [[ -z ${SYSUPDATE_HEADLESS:-} ]]; then
  echo
  dim "Press Enter to close…"
  read -r _ || true
fi
