#!/bin/sh
# KDE-safe Waybar entrypoint for interactive use.
#
# In the KDE session, plain `waybar` should repair/restart the managed service
# rather than spawning a second layer-shell bar that can push the real one down.
# Use /usr/bin/waybar or WAYBAR_RAW=1 waybar to launch the raw binary.
set -eu

if [ "${WAYBAR_RAW:-}" = "1" ]; then
  exec /usr/bin/waybar "$@"
fi

if [ "$#" -eq 0 ] && [ "${XDG_CURRENT_DESKTOP:-}" = "KDE" ]; then
  if command -v systemctl >/dev/null 2>&1 && systemctl --user list-unit-files waybar.service >/dev/null 2>&1; then
    systemctl --user restart waybar.service
    systemctl --user --no-pager --full status waybar.service
    exit 0
  fi
fi

exec /usr/bin/waybar "$@"
