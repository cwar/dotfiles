#!/usr/bin/env bash
# tmux-url-picker: Parse URLs from visible tmux pane, pick with fzf, open or copy

set -euo pipefail

# Capture visible pane content + scrollback. -J joins wrapped lines so a URL
# that wrapped at the terminal width survives as a single token.
CONTENT=$(tmux capture-pane -p -J -S -500 2>/dev/null || tmux capture-pane -p -J)

# Extract URLs (http/https/ftp, git@, file://, bare domains)
# Commas and semicolons are legal *inside* a URL (RFC 3986 sub-delims) and turn up
# in real query strings (?methods=a,b), so they must not terminate a match. They're
# stripped only when trailing, where they're almost always prose punctuation.
URLS=$(echo "$CONTENT" | grep -oP '(https?://|ftp://|file://)[^\s<>"'\''\)\]\}│┃|]+' |
       sed -E 's/[.,;:!?]+$//' |  # trim trailing prose punctuation
       awk '!seen[$0]++')  # deduplicate, preserve order

if [ -z "$URLS" ]; then
    tmux display-message "No URLs found on screen"
    exit 0
fi

# Count URLs
URL_COUNT=$(echo "$URLS" | wc -l)

# Use fzf in tmux popup to pick URL(s) and action
SELECTED=$(echo "$URLS" | fzf-tmux -p 90%,60% \
    --multi \
    --reverse \
    --header="╸ $URL_COUNT URLs found ╺ space/tab=mark │ enter=open │ ctrl-y=copy marked │ ctrl-a=copy all" \
    --prompt="🔗 " \
    --bind="space:toggle" \
    --bind="alt-a:select-all" \
    --bind="alt-d:deselect-all" \
    --bind="ctrl-a:execute-silent(echo '$URLS' | wl-copy)+abort" \
    --expect="enter,ctrl-y" \
    --color="bg:#0a0e14,fg:#d4ffda,header:#39ff14,prompt:#39ff14,pointer:#39ff14,hl:#5c7a65,hl+:#39ff14,info:#5c7a65" \
    2>/dev/null) || exit 0

# Parse fzf output: first line is the key pressed, rest are selections
KEY=$(echo "$SELECTED" | head -1)
CHOSEN=$(echo "$SELECTED" | tail -n +2)

[ -z "$CHOSEN" ] && exit 0

if [ "$KEY" = "ctrl-y" ]; then
    echo -n "$CHOSEN" | wl-copy
    COUNT=$(echo "$CHOSEN" | wc -l)
    if [ "$COUNT" -eq 1 ]; then
        tmux display-message "📋 Copied: $CHOSEN"
    else
        tmux display-message "📋 Copied $COUNT URLs to clipboard"
    fi
else
    # Open each selected URL. setsid -f detaches the spawn into its own
    # session with no controlling tty so a cold-starting browser survives
    # this script's exit (a backgrounded xdg-open inherits tmux's tty and
    # gets SIGHUP'd before chromium finishes mapping its window).
    while IFS= read -r url; do
        setsid -f xdg-open "$url" </dev/null >/dev/null 2>&1
    done <<< "$CHOSEN"
    COUNT=$(echo "$CHOSEN" | wc -l)
    if [ "$COUNT" -eq 1 ]; then
        tmux display-message "🌐 Opened: $CHOSEN"
    else
        tmux display-message "🌐 Opened $COUNT URLs"
    fi
fi
