#!/usr/bin/env python3
"""Single enhanced notification for Spectacle clipboard screenshots.

Spectacle's built-in clipboard notification cannot show custom text/actions. We
suppress that popup with a user notifyrc override, watch KWin screenshot D-Bus
capture calls, then save the clipboard PNG and post one notification. Clicking
the notification opens the image in Spectacle's annotation editor.
"""

from __future__ import annotations

import datetime as _dt
import os
import pathlib
import signal
import subprocess
import sys
import threading
import time
from typing import Iterable

APP_NAME = "Screenshot"
SCREENSHOT_DBUS_MATCH = "destination='org.kde.KWin.ScreenShot2',interface='org.kde.KWin.ScreenShot2'"
SPECTACLE_MARKER_TYPES = {
    "application/x-qt-image",
    "x-kde-force-image-copy",
    "application/x-kde-suggestedfilename",
}


def screenshot_dir() -> pathlib.Path:
    return pathlib.Path(os.environ.get("XDG_SCREENSHOTS_DIR", pathlib.Path.home() / "Pictures" / "Screenshots"))


def state_dir() -> pathlib.Path:
    return pathlib.Path(os.environ.get("XDG_STATE_HOME", pathlib.Path.home() / ".local" / "state")) / "kde-screenshot"


def run_quiet(args: list[str]) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(args, check=False, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)


def is_capture_line(line: str) -> bool:
    return (
        line.startswith("method call ")
        and "interface=org.kde.KWin.ScreenShot2" in line
        and "member=Capture" in line
    )


def clipboard_types() -> set[str]:
    result = run_quiet(["wl-paste", "--list-types"])
    if result.returncode != 0:
        return set()
    return {line.strip() for line in result.stdout.decode(errors="replace").splitlines() if line.strip()}


def looks_like_spectacle_image(types: set[str]) -> bool:
    return "image/png" in types and bool(types & SPECTACLE_MARKER_TYPES)


def wait_for_clipboard_png(timeout_s: float = 4.0) -> bytes | None:
    deadline = time.monotonic() + timeout_s
    while time.monotonic() < deadline:
        if looks_like_spectacle_image(clipboard_types()):
            result = run_quiet(["wl-paste", "--type", "image/png"])
            if result.returncode == 0 and result.stdout.startswith(b"\x89PNG\r\n\x1a\n"):
                return result.stdout
        time.sleep(0.1)
    return None


def save_png(data: bytes) -> pathlib.Path:
    out_dir = screenshot_dir()
    out_dir.mkdir(parents=True, exist_ok=True)
    state = state_dir()
    state.mkdir(parents=True, exist_ok=True)

    stamp = _dt.datetime.now().strftime("%Y%m%d_%H%M%S")
    path = out_dir / f"Screenshot_{stamp}_clipboard.png"
    path.write_bytes(data)
    (state / "last").write_text(str(path) + "\n")
    return path


def annotate_file(path: pathlib.Path) -> None:
    subprocess.Popen(["spectacle", "--edit-existing", str(path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def action_invoked(notification_id: int, timeout_s: float = 30.0) -> bool:
    proc = subprocess.Popen(
        [
            "dbus-monitor",
            "--session",
            "interface='org.freedesktop.Notifications',member='ActionInvoked'",
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        bufsize=1,
    )
    assert proc.stdout is not None
    deadline = time.monotonic() + timeout_s
    pending_id: int | None = None
    try:
        while time.monotonic() < deadline:
            line = proc.stdout.readline()
            if not line:
                time.sleep(0.05)
                continue
            stripped = line.strip()
            if stripped.startswith("uint32 "):
                try:
                    pending_id = int(stripped.split()[1])
                except (IndexError, ValueError):
                    pending_id = None
            elif pending_id == notification_id and stripped == 'string "default"':
                return True
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=1)
        except subprocess.TimeoutExpired:
            proc.kill()
    return False


def notify(path: pathlib.Path) -> None:
    body = (
        "Copied to clipboard and saved.\n"
        "Click this notification to annotate.\n"
        "Meta+Print opens Spectacle."
    )
    monitor_ready = threading.Event()

    notification_id_holder: dict[str, int] = {}
    clicked_holder: dict[str, bool] = {}

    def wait_for_click() -> None:
        monitor_ready.set()
        notification_id = notification_id_holder.get("id")
        # Wait until the D-Bus Notify call returns the notification id.
        deadline = time.monotonic() + 2
        while notification_id is None and time.monotonic() < deadline:
            time.sleep(0.02)
            notification_id = notification_id_holder.get("id")
        if notification_id is not None and action_invoked(notification_id):
            clicked_holder["clicked"] = True
            annotate_file(path)

    waiter = threading.Thread(target=wait_for_click, daemon=True)
    waiter.start()
    monitor_ready.wait(timeout=1)

    result = subprocess.run(
        [
            "gdbus",
            "call",
            "--session",
            "--dest",
            "org.freedesktop.Notifications",
            "--object-path",
            "/org/freedesktop/Notifications",
            "--method",
            "org.freedesktop.Notifications.Notify",
            APP_NAME,
            "0",
            str(path),
            "Screenshot copied",
            body,
            "['default','Annotate']",
            "{}",
            "8000",
        ],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    # gdbus prints either `(uint32 23,)` or `(23,)` depending on version.
    for token in result.stdout.replace("(", " ").replace(")", " ").replace(",", " ").split():
        if token.isdigit():
            notification_id_holder["id"] = int(token)
            break


def handle_capture() -> None:
    data = wait_for_clipboard_png()
    if data is None:
        return
    path = save_png(data)
    notify(path)


def run() -> int:
    stop = False

    def request_stop(_signum: int, _frame: object) -> None:
        nonlocal stop
        stop = True

    signal.signal(signal.SIGINT, request_stop)
    signal.signal(signal.SIGTERM, request_stop)

    proc = subprocess.Popen(
        ["dbus-monitor", "--session", SCREENSHOT_DBUS_MATCH],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        bufsize=1,
    )
    assert proc.stdout is not None

    try:
        for line in proc.stdout:
            if stop:
                break
            if is_capture_line(line):
                threading.Thread(target=handle_capture, daemon=True).start()
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()
    return 0


def self_test() -> int:
    capture = "method call time=1 sender=:1 -> destination=org.kde.KWin.ScreenShot2 serial=1 path=/org/kde/KWin/ScreenShot2; interface=org.kde.KWin.ScreenShot2; member=CaptureActiveWindow\n"
    non_capture = "method call time=1 sender=:1 -> destination=org.kde.KWin.ScreenShot2 serial=2 path=/org/kde/KWin/ScreenShot2; interface=org.freedesktop.DBus.Properties; member=Get\n"
    checks = [
        (is_capture_line(capture), "capture method should match"),
        (not is_capture_line(non_capture), "non-capture method should not match"),
        (looks_like_spectacle_image({"image/png", "application/x-qt-image"}), "qt image marker should match"),
        (not looks_like_spectacle_image({"image/png"}), "plain png should not match"),
    ]
    failed = [message for ok, message in checks if not ok]
    if failed:
        for message in failed:
            print(f"FAIL: {message}", file=sys.stderr)
        return 1
    print("self-test passed")
    return 0


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--self-test":
        raise SystemExit(self_test())
    raise SystemExit(run())
