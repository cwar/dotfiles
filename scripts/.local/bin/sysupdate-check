#!/usr/bin/env bash
set -uo pipefail

# sysupdate-check — detect available system updates across every package
# manager on this box and emit a Waybar JSON object (the "cycle" icon).
#
# Ported from the Omarchy/Arch `updates-available` indicator to an
# Ubuntu LTS fleet: apt, flatpak, snap, Homebrew, npm (global), mise.
#
# Modes:
#   (no args)    Print one Waybar JSON line: {text, tooltip, class}
#   --summary    Human per-manager breakdown on stdout (used by sysupdate-launch)
#   --self-test  Run internal unit tests and exit
#
# Waybar wiring (custom/sysupdate, return-type "json", signal 8):
#   - no updates  -> empty text, so the module is HIDDEN entirely
#   - updates     -> yellow "<glyph> N", class "has-updates"
#
# Phased apt updates (held back by Ubuntu's staged rollout) are NOT counted and
# NOT reported: they aren't actionable and roll out automatically. count_apt
# simulates the real upgrade plan, which already excludes them.
#
# Notes on safety: this runs unattended (hourly + on SIGRTMIN+8). It NEVER
# uses sudo and NEVER refreshes apt's package lists (that needs root + net and
# is handled by the apt-daily timer). Each network-touching manager is wrapped
# in `timeout` and run in parallel so the bar never blocks for long.

ICON=$'\uf021' # nf-fa-refresh — the "cycle" glyph

# Per-manager wall-clock budget. Overridable so --self-test can use a tiny value.
: "${SYSUPDATE_TIMEOUT:=30}"

# ERR is the sentinel for "this check could not complete". It must stay distinct
# from 0: collapsing the two is what silently dropped brew from the bar, because
# a killed check and a clean check produced the same count.
ERR_SENTINEL=ERR

# prepend_mise_shims: make mise-managed tools (node, npm, and the globals they
# own — e.g. pi) resolvable in NON-interactive environments. Waybar runs as a
# systemd user service and never sources ~/.bashrc, where `mise activate` lives,
# so node/npm aren't on PATH and count_npm() is silently skipped. mise shims
# self-resolve the active version, so adding the dir is sufficient. Idempotent;
# honours $MISE_SHIMS to allow testing.
prepend_mise_shims() {
  local shims=${MISE_SHIMS:-$HOME/.local/share/mise/shims}
  [[ -d $shims ]] || return 0
  case ":$PATH:" in
    *":$shims:"*) ;;
    *)
      PATH="$shims:$PATH"
      export PATH
      ;;
  esac
}

# ---- counting helpers -------------------------------------------------------

# timed_count CMD...: run CMD under $SYSUPDATE_TIMEOUT and print how many lines
# it produced, or ERR if the timeout fired (124 = killed by timeout, 137 =
# SIGKILL after --kill-after).
#
# The command's OWN exit status is deliberately ignored: several of these tools
# exit non-zero precisely *because* they found updates (`npm outdated` exits 1),
# so treating any non-zero status as failure would misreport a normal result.
# Only a fired timeout is a real failure.
timed_count() {
  local out rc
  out=$(timeout "$SYSUPDATE_TIMEOUT" "$@" 2>/dev/null)
  rc=$?
  if ((rc == 124 || rc == 137)); then
    printf '%s\n' "$ERR_SENTINEL"
    return 0
  fi
  printf '%s\n' "$out" | grep -c . || true
}

# count_apt: packages apt would ACTUALLY upgrade right now (no sudo, no net).
# We simulate `full-upgrade` and count `Inst` lines instead of using
# `apt list --upgradable`, because the latter also lists packages that Ubuntu's
# phased-update rollout is deliberately holding back. Counting the real plan is
# what lets the indicator clear after an update completes.
count_apt() {
  command -v apt-get >/dev/null 2>&1 || return 0
  apt-get -s full-upgrade 2>/dev/null | grep -c '^Inst' || true
}

# flatpak_remote_commit_is_installed_parent: true when Flatpak's remote
# "update" commit is actually the installed commit's parent. Flatpak refuses to
# deploy those with "Update is older than current version", so they are not
# actionable updates and should not keep the Waybar indicator lit.
flatpak_remote_commit_is_installed_parent() {
  local installed_parent=${1:-} remote_commit=${2:-}
  [[ -n $installed_parent && -n $remote_commit && $installed_parent == "$remote_commit"* ]]
}

flatpak_installed_parent_for_ref() {
  local ref=$1 kind name _arch branch info
  IFS=/ read -r kind name _arch branch <<<"$ref"
  [[ -n ${kind:-} && -n ${name:-} && -n ${branch:-} ]] || return 1

  info=$(flatpak info "$name" "$branch" 2>/dev/null) || return 1
  awk '$1 == "Parent:" { print $2; exit }' <<<"$info"
}

# count_flatpak: Flatpak refs with a pending, actionable update.
count_flatpak() {
  command -v flatpak >/dev/null 2>&1 || return 0

  local ref _origin commit parent count=0
  while IFS=$'\t' read -r ref _origin commit; do
    [[ -n ${ref:-} && -n ${commit:-} ]] || continue

    parent=$(flatpak_installed_parent_for_ref "$ref") || parent=""
    if flatpak_remote_commit_is_installed_parent "$parent" "$commit"; then
      continue
    fi

    count=$((count + 1))
  done < <(timeout 20 flatpak remote-ls --updates --columns=ref,origin,commit 2>/dev/null || true)

  printf '%d\n' "$count"
}

# count_snap: snaps with a pending refresh.
count_snap() {
  command -v snap >/dev/null 2>&1 || return 0
  local out
  out=$(timeout 20 snap refresh --list 2>/dev/null) || true
  # "All snaps up to date." => 0; otherwise a "Name Version ..." header + rows.
  if printf '%s\n' "$out" | grep -q '^Name'; then
    printf '%s\n' "$out" | grep -cvE '^(Name|$)' || true
  else
    printf '0\n'
  fi
}

# count_brew: outdated formulae/casks, from the LAST tap fetch — no network.
#
# HOMEBREW_NO_AUTO_UPDATE=1 is load-bearing. Without it, `brew outdated` quietly
# triggers Homebrew's auto-update whenever the last fetch is older than
# HOMEBREW_AUTO_UPDATE_SECS (default 86400). That cold path re-fetches every tap,
# routinely overran the timeout, and — because a killed check used to read as 0 —
# made brew disappear from the bar for the first poll of each day.
# sysupdate-launch owns the network refresh via `brew update`.
count_brew() {
  command -v brew >/dev/null 2>&1 || return 0
  timed_count env HOMEBREW_NO_AUTO_UPDATE=1 brew outdated --quiet
}

# npm_count_outdated_json: count entries in `npm outdated --json` whose current
# differs from wanted after stripping a leading v/=. Some tarballs (fleetctl)
# ship "v4.94.0"; npm outdated string-compares it as stale but npm update -g
# treats it as current, so the indicator could never clear.
npm_count_outdated_json() {
  jq '[.[] | (if type == "array" then .[] else . end)
       | select(((.current // "") | sub("^[v=]+"; ""))
             != ((.wanted // "") | sub("^[v=]+"; "")))] | length' 2>/dev/null || printf '0\n'
}

# count_npm: globally-installed npm packages that `npm update -g` would change.
# NB: `npm outdated` exits 1 when it finds anything, so only a timeout is ERR.
count_npm() {
  command -v npm >/dev/null 2>&1 || return 0
  local out rc
  out=$(timeout "$SYSUPDATE_TIMEOUT" npm outdated -g --json 2>/dev/null)
  rc=$?
  if ((rc == 124 || rc == 137)); then
    printf '%s\n' "$ERR_SENTINEL"
    return 0
  fi
  [[ -n $out ]] || out='{}'
  printf '%s\n' "$out" | npm_count_outdated_json
}

# count_mise: tools mise can upgrade.
count_mise() {
  command -v mise >/dev/null 2>&1 || return 0
  # `mise outdated` prints a "Tool ..." header followed by one row per tool.
  timeout 30 mise outdated 2>/dev/null | grep -cvE '^(Tool|$)' || true
}

# normalize: turn possibly-empty / multiline output into a single integer.
normalize() {
  local n=${1:-0}
  # Preserve the failure sentinel; everything else becomes an integer.
  if [[ $n == *"$ERR_SENTINEL"* ]]; then
    printf '%s\n' "$ERR_SENTINEL"
    return 0
  fi
  n=${n//[!0-9]/}
  printf '%d\n' "$((10#${n:-0}))"
}

# ---- detection orchestration ------------------------------------------------

# detect: populate the global associative array COUNTS[manager]=N, running the
# per-manager checks in parallel. Only managers that exist are included.
declare -A COUNTS=()
declare -A LABELS=(
  [apt]="apt" [flatpak]="flatpak" [snap]="snap"
  [brew]="brew" [npm]="npm -g" [mise]="mise"
)
ORDER=(apt flatpak snap brew npm mise)

detect() {
  prepend_mise_shims
  local tmp
  tmp=$(mktemp -d) || return 1

  local m
  for m in "${ORDER[@]}"; do
    normalize "$("count_${m}")" >"$tmp/$m" &
  done
  wait

  for m in "${ORDER[@]}"; do
    [[ -s "$tmp/$m" ]] && COUNTS[$m]=$(<"$tmp/$m")
  done

  rm -rf "$tmp"
}

# total: sum of all manager counts. Failed checks contribute nothing (their real
# count is unknown) but are surfaced separately via has_error.
total() {
  local sum=0 m
  for m in "${!COUNTS[@]}"; do
    [[ ${COUNTS[$m]} == "$ERR_SENTINEL" ]] && continue
    sum=$((sum + COUNTS[$m]))
  done
  printf '%d\n' "$sum"
}

# has_error: true when at least one manager's check failed to complete.
has_error() {
  local m
  for m in "${!COUNTS[@]}"; do
    [[ ${COUNTS[$m]} == "$ERR_SENTINEL" ]] && return 0
  done
  return 1
}

# build_lines: one "label: count" line per manager that has a non-zero count.
# Used by the JSON tooltip and the --summary output so they stay consistent.
build_lines() {
  local m c
  for m in "${ORDER[@]}"; do
    c=${COUNTS[$m]:-0}
    if [[ $c == "$ERR_SENTINEL" ]]; then
      printf '%s: check failed\n' "${LABELS[$m]}"
      continue
    fi
    ((c > 0)) || continue
    printf '%s: %s\n' "${LABELS[$m]}" "$c"
  done
}

# ---- output modes -----------------------------------------------------------

emit_json() {
  detect
  local sum
  sum=$(total)

  if ((sum == 0)) && ! has_error; then
    # Nothing actionable -> empty text hides the module entirely.
    printf '{"text":""}\n'
    return 0
  fi

  local text tooltip class
  text="$ICON $sum"
  if has_error; then
    # Stay visible and turn red (#custom-sysupdate.error) so a broken check is
    # never mistaken for "up to date".
    class="error"
    tooltip="$sum update(s) available — some checks failed"$'\n'"$(build_lines)"
  else
    class="has-updates"
    tooltip="$sum update(s) available"$'\n'"$(build_lines)"
  fi

  jq -cn --arg text "$text" --arg tooltip "$tooltip" --arg class "$class" \
    '{text: $text, tooltip: $tooltip, class: $class}'
}

emit_summary() {
  detect
  local m c
  for m in "${ORDER[@]}"; do
    [[ -n ${COUNTS[$m]+x} ]] || continue
    c=${COUNTS[$m]}
    [[ $c == "$ERR_SENTINEL" ]] && c="check failed"
    printf '%-10s %s\n' "${LABELS[$m]}" "$c"
  done
}

# ---- self test --------------------------------------------------------------

self_test() {
  local fails=0
  check() {
    local desc=$1 got=$2 want=$3
    if [[ $got == "$want" ]]; then
      printf 'ok   - %s\n' "$desc"
    else
      printf 'FAIL - %s (got %q want %q)\n' "$desc" "$got" "$want"
      fails=$((fails + 1))
    fi
  }

  check "normalize empty" "$(normalize "")" "0"
  check "normalize plain int" "$(normalize "7")" "7"
  check "normalize trailing nl" "$(normalize $'3\n')" "3"
  check "normalize junk" "$(normalize "x12y")" "12"
  check "normalize zero-padded" "$(normalize "08")" "8"
  check "normalize keeps ERR sentinel" "$(normalize "ERR")" "ERR"

  # timed_count(): only a fired timeout counts as failure. A non-zero exit from
  # the tool itself must NOT, because `npm outdated` exits 1 precisely when it
  # finds updates -- treating that as an error would misreport a normal result.
  check "timed_count maps timeout to ERR" \
    "$(SYSUPDATE_TIMEOUT=0.05 timed_count sleep 5)" "ERR"
  check "timed_count counts lines despite tool exit 1" \
    "$(timed_count sh -c 'printf "a\nb\n"; exit 1')" "2"
  check "timed_count zero lines is 0 not ERR" \
    "$(timed_count true)" "0"

  # count_brew() must never trigger Homebrew's auto-update. That network path is
  # what blew the timeout on a cold cache and made brew vanish from the bar.
  local _brewdir _brew_got _brew_saved_path=$PATH
  _brewdir=$(mktemp -d)
  cat >"$_brewdir/brew" <<'FAKEBREW'
#!/usr/bin/env bash
if [ -z "${HOMEBREW_NO_AUTO_UPDATE:-}" ]; then
  echo "auto-update-would-have-run"
  exit 0
fi
printf 'formula-a\nformula-b\nformula-c\n'
FAKEBREW
  chmod +x "$_brewdir/brew"
  PATH="$_brewdir:$PATH"
  _brew_got=$(count_brew)
  PATH=$_brew_saved_path
  rm -rf "$_brewdir"
  check "count_brew suppresses brew auto-update" "$_brew_got" "3"

  check "npm json ignores leading-v version mismatch" \
    "$(printf '%s' '{"fleetctl":{"current":"v4.94.0","wanted":"4.94.0","latest":"4.94.0"}}' | npm_count_outdated_json)" "0"
  check "npm json counts real updates" \
    "$(printf '%s' '{"a":{"current":"1.0.0","wanted":"1.1.0"},"b":{"current":"2.0.0","wanted":"2.0.0"}}' | npm_count_outdated_json)" "1"
  check "npm json empty object is 0" "$(printf '{}' | npm_count_outdated_json)" "0"

  # prepend_mise_shims(): prepends the shims dir to PATH when it exists, and is
  # idempotent (a second call must not add it twice).
  local _saved_path=$PATH _shimdir _got1 _got2
  _shimdir=$(mktemp -d)
  PATH=/usr/bin
  MISE_SHIMS=$_shimdir
  prepend_mise_shims
  _got1=$PATH
  prepend_mise_shims
  _got2=$PATH
  PATH=$_saved_path
  unset MISE_SHIMS
  rm -rf "$_shimdir"
  check "prepend_mise_shims prepends shims dir" "$_got1" "$_shimdir:/usr/bin"
  check "prepend_mise_shims is idempotent" "$_got2" "$_shimdir:/usr/bin"

  # Flatpak sometimes reports a remote "update" whose commit is actually the
  # installed commit's parent. That is a downgrade, not an actionable update.
  local _flatpak_parent=75a3afca1efc7dd75c34ba1873e08c39ddd0bd35b3901059985d08bc6474340a
  local _flatpak_short=75a3afca1efc _flatpak_other=f92f0c46fce1
  local _flatpak_match=no _flatpak_miss=yes
  if flatpak_remote_commit_is_installed_parent "$_flatpak_parent" "$_flatpak_short"; then
    _flatpak_match=yes
  fi
  if flatpak_remote_commit_is_installed_parent "$_flatpak_parent" "$_flatpak_other"; then
    _flatpak_miss=no
  fi
  check "flatpak parent prefix is non-actionable" "$_flatpak_match" "yes"
  check "flatpak unrelated commit stays actionable" "$_flatpak_miss" "yes"

  # total() over a synthetic COUNTS map.
  COUNTS=([apt]=2 [snap]=0 [brew]=5)
  check "total sums counts" "$(total)" "7"
  COUNTS=()
  check "total empty is zero" "$(total)" "0"

  # build_lines(): only managers with a non-zero count appear.
  COUNTS=([apt]=3 [snap]=0 [brew]=1)
  check "build_lines skips zero counts" "$(build_lines)" "$(printf 'apt: 3\nbrew: 1')"
  COUNTS=()
  check "build_lines empty when nothing" "$(build_lines)" ""

  # A failed check must stay visible and must never be summed as 0 updates.
  COUNTS=([apt]=2 [brew]=ERR)
  check "total ignores ERR" "$(total)" "2"
  check "has_error true when a check failed" \
    "$(
      has_error && echo yes || echo no
    )" "yes"
  check "build_lines surfaces failed check" \
    "$(build_lines)" "$(printf 'apt: 2\nbrew: check failed')"
  COUNTS=([apt]=2)
  check "has_error false when all checks ran" \
    "$(
      has_error && echo yes || echo no
    )" "no"
  COUNTS=()

  # JSON shape with a forced count.
  COUNTS=([apt]=3)
  local json
  json=$(
    sum=3
    text="$ICON 3"
    jq -cn --arg text "$text" --arg tooltip "t" --arg class "has-updates" \
      '{text:$text,tooltip:$tooltip,class:$class}'
  )
  check "json is valid" "$(printf '%s' "$json" | jq -r '.class')" "has-updates"
  check "json text has count" "$(printf '%s' "$json" | jq -r '.text' | grep -o '3$')" "3"

  printf '\n%d failure(s)\n' "$fails"
  return "$fails"
}

# ---- main -------------------------------------------------------------------

case "${1:-}" in
  --summary) emit_summary ;;
  --self-test) self_test ;;
  "") emit_json ;;
  *)
    printf 'usage: %s [--summary|--self-test]\n' "${0##*/}" >&2
    exit 2
    ;;
esac
